DOMAIN=example.private.yourdomain.com
TLS_CERT_NAME=example
SITE_TITLE=My Game
DB_PASSWORD=changeme
DJANGO_SECRET_KEY=changeme
HOST_PORT=40443
DJANGO_SETTINGS_MODULE=game_mvc.settings.production
# Postgres data location: "pgdata" (named volume, dev) or an absolute
# path to bind-mount (e.g. /mnt/postgresqldb on the prod EBS volume).
POSTGRES_DATA_VOLUME=pgdata
